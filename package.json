{
  "name": "@file-browser-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "serve:api": "nx serve api",
    "serve:web": "nx serve web",
    "dev": "concurrently -k -n api,web \"nx serve api\" \"wait-on http://localhost:3000/api && nx serve web\"",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "test": "nx run-many -t test --projects=api,web",
    "test:api": "nx test api",
    "test:web": "nx test web",
    "lint": "eslint apps/web/src apps/api/src --max-warnings 0",
    "verify": "pnpm run lint && pnpm test",
    "git:feature": "node scripts/git-feature-from-trunk.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "22.6.0",
    "@nx/js": "22.6.0",
    "@nx/nest": "^22.6.0",
    "@nx/node": "22.6.0",
    "@nx/playwright": "22.6.0",
    "@nx/react": "^22.6.0",
    "@nx/vite": "22.6.0",
    "@nx/web": "22.6.0",
    "@nx/webpack": "22.6.0",
    "@nx/workspace": "22.6.0",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "~4.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jest": "^30.3.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.6.0",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.0",
    "vitest": "~4.0.0",
    "wait-on": "^8.0.1",
    "webpack-cli": "^5.1.4"
